# Copie para .env.local (local) e configure as mesmas chaves na Vercel.

# Postgres (Neon recomendado via Vercel Marketplace; qualquer Postgres 13+ serve).
# Use a connection string "pooled" e com sslmode=require em produção.
DATABASE_URL=postgres://postgres@localhost:5432/pitdrive_waitlist

# Texto aleatório e secreto usado para gerar o hash do IP no rate limit.
# Gere com: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
IP_HASH_SALT=troque-por-um-valor-aleatorio

# Opcional. URL pública para canonical/Open Graph. Sem ela, usa o domínio *.vercel.app de produção.
# Quando houver domínio próprio: SITE_URL=https://pitdrive.com.br
SITE_URL=

# Opcional. Outras origens autorizadas a enviar o formulário (separadas por vírgula).
# O próprio domínio da página já é aceito automaticamente.
ALLOWED_ORIGINS=
